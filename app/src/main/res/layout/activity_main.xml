<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="40dp"
    android:paddingTop="20dp"
    android:paddingRight="40dp"
    android:paddingBottom="12dp">

    <!-- top bar: logo, title, search, refresh, settings -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_launcher" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:minWidth="130dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hindi TV"
                android:textColor="@color/text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textSize="13sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/search"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search"
            android:drawableLeft="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:focusable="true"
            android:hint="Search channels"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textColorHint="@color/text_dim"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/btnRefresh"
            style="@style/IconBtn"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:src="@drawable/ic_refresh" />

        <ImageView
            android:id="@+id/btnSettings"
            style="@style/IconBtn"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginLeft="8dp"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- tabs, quality filters, playlist -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnAll"
            style="@style/Chip"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="All" />

        <TextView
            android:id="@+id/btnFav"
            style="@style/Chip"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginLeft="8dp"
            android:text="Favorites" />

        <TextView
            android:id="@+id/btnNum"
            style="@style/Chip"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginLeft="8dp"
            android:text="Numbers" />

        <TextView
            android:id="@+id/btnRecent"
            style="@style/Chip"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginLeft="8dp"
            android:text="Recent" />

        <View
            android:layout_width="2dp"
            android:layout_height="24dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:background="@color/line" />

        <TextView
            android:id="@+id/btnHd"
            style="@style/Chip"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="HD" />

        <TextView
            android:id="@+id/btn4k"
            style="@style/Chip"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginLeft="8dp"
            android:text="4K" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnPlaylist"
            style="@style/Chip"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:drawableLeft="@drawable/ic_apps"
            android:drawablePadding="8dp"
            android:text="Hindi" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:text="Loading channels..."
        android:textColor="@color/text_dim"
        android:textSize="14sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textColor="@color/text_dim"
        android:textSize="13sp" />
</LinearLayout>
